{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\MinGW\\bin\\gcc.exe",
            "args": [
                "-Wall", "-Wextra", "-g3",
                "-nostdinc",
                "-isystem", "C:\\MinGW\\x86_64-w64-mingw32\\include",
                "-isystem", "C:\\MinGW\\lib\\gcc\\x86_64-w64-mingw32\\15.2.0\\include",
                "-I${workspaceFolder}\\include",
                "-I${workspaceFolder}\\vendor",
                "${workspaceFolder}\\main.c",
                "${workspaceFolder}\\src\\gap_buffer.c",
                "${workspaceFolder}\\src\\text_renderer.c",
                "${workspaceFolder}\\src\\editor.c",
                "${workspaceFolder}\\src\\file_panel.c",
                "${workspaceFolder}\\src\\terminal.c",
                "-o", "${workspaceFolder}\\output\\RMGBE.exe",
                "-L${workspaceFolder}\\lib",
                "-lglfw3", "-lopengl32", "-lgdi32", "-lole32", "-lcomdlg32", "-lshell32", "-lm"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
